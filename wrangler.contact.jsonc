{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "strathub360-contact",
  "main": "workers/contact-email.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "strathub360.com/api/contact", "zone_name": "strathub360.com" },
    { "pattern": "www.strathub360.com/api/contact", "zone_name": "strathub360.com" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
